          "__rl": true,
          "value": "COLE_AQUI_O_ID_DO_PDF_NO_DRIVE",
          "mode": "id"
        },
        "options": {}
      },
      "id": "2e000000-0004-4000-8000-000000000004",
      "name": "Baixar PDF do Drive",
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [
        440,
        0
      ],
      "executeOnce": true,
